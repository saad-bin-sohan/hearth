{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter analyze)",
      "Bash(flutter test*)",
      "Bash(flutter pub run build_runner*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "ask": [
      "Bash(flutter build*)",
      "Bash(flutter run*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Bash(rm -rf*)"
    ]
  }
}
